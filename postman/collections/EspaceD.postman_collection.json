        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "3612ac0d-c8ff-4dd8-b5a6-9de12eb0f1d6",
                "exec": [
                  "// Parse la réponse JSON\r",
                  "let jsonData = pm.response.json();\r",
                  "\r",
                  "// Vérifie si le token est présent dans la réponse\r",
                  "if (jsonData.access_token || jsonData.access_token) {\r",
                  "    // Sauvegarde le token dans l'environnement actif\r",
                  "    pm.environment.set(\"authToken\", jsonData.token || jsonData.access_token);\r",
                  "    console.log(\"✅ Token enregistré dans l'environnement :\", pm.environment.get(\"token\"));\r",
                  "} else {\r",
                  "    console.log(\"⚠️ Aucun token trouvé dans la réponse !\");\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "id": "b3245273-d449-450e-8578-ac2c2bf7c683",
